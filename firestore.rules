rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.email == 'Karimhemedi@yahoo.com');
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'Karimhemedi@yahoo.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Packages Collection
    match /packages/{packageId} {
      allow read: if true; // Public list and get
      allow create: if isAdmin() && isValidId(packageId) && isValidPackage(incoming());
      allow update: if isAdmin() && isValidId(packageId) && isValidPackage(incoming());
      allow delete: if isAdmin();
    }

    function isValidPackage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128
          && data.price is int && data.price >= 0 && data.price < 1000000
          && data.route is string && data.route.size() > 0 && data.route.size() <= 500
          && data.days is int && data.days > 0 && data.days <= 365
          && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
          && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2048;
    }

    // 4. Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && existing().email == request.auth.token.email);
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    function isValidBooking(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128
          && data.email is string && data.email.size() > 0 && data.email.size() <= 256
          && data.packageId is string && data.packageId.size() <= 128
          && data.packageName is string && data.packageName.size() > 0 && data.packageName.size() <= 128
          && data.people is int && data.people > 0 && data.people <= 1000
          && data.message is string && data.message.size() <= 5000
          && data.status is string && (data.status == 'pending' || data.status == 'reviewed');
    }

    // 5. News Collection (Safari updates & blog)
    match /news/{newsId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidId(newsId) && isValidNews(incoming());
      allow update: if isAdmin() && isValidId(newsId) && isValidNews(incoming());
      allow delete: if isAdmin();
    }

    function isValidNews(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 256
          && data.content is string && data.content.size() > 0 && data.content.size() <= 50000
          && data.imageUrl is string && data.imageUrl.size() <= 2048;
    }

    // 6. Comments & Reviews Collection (Signed-in and verified users)
    match /comments/{commentId} {
      allow read: if true; // Public feedback
      allow create: if isEmailVerified() && isValidId(commentId) && isValidComment(incoming());
      allow update: if isEmailVerified() && existing().userId == request.auth.uid && isValidComment(incoming());
      allow delete: if isAdmin() || (isEmailVerified() && existing().userId == request.auth.uid);
    }

    function isValidComment(data) {
      return data.userId is string && data.userId == request.auth.uid
          && data.username is string && data.username.size() > 0 && data.username.size() <= 128
          && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000;
    }
  }
}
